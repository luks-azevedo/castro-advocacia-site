---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import BenefitsSection from '../components/sections/BenefitsSection.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import CTASection from '../components/sections/CTASection.astro';
import { photos, areas, howItWorks, faq } from '../data/castro';
import { primaryContactHref } from '../lib/contact';

const contactHref = primaryContactHref();
const homeAreas = areas.filter((a) => a.id !== 'advogados').map((a) => ({ ...a, href: `/areas#${a.id}` }));
---

<BaseLayout>
  <Hero
    variant="split"
    eyebrow="Advocacia Especializada"
    title="Soluções jurídicas personalizadas e estratégicas."
    description="Atuação em Direito Civil, do Consumidor, Imobiliário e do Trabalho. Atendimento presencial em Belo Horizonte e Conselheiro Lafaiete e online em todo o Brasil."
    primaryCta={{ label: 'Agendar atendimento', href: contactHref }}
    secondaryCta={{ label: 'Áreas de atuação', href: '/areas' }}
    image={photos.hero}
    highlights={['Presencial em BH e Lafaiete', 'Online em todo o Brasil']}
    decor
  />

  <ServicesSection
    tone="surface"
    eyebrow="Áreas de atuação"
    title="Como podemos ajudar"
    description="Orientação jurídica clara para as questões do dia a dia, com análise individual de cada caso."
    items={homeAreas}
    cta={{ label: 'Ver todas as áreas', href: '/areas' }}
  />

  <AboutSection
    eyebrow="O escritório"
    title="Atendimento próximo, do primeiro contato ao acompanhamento."
    paragraphs={[
      'A Castro Advocacia é conduzida pela advogada Carolina Araújo, com atuação em Direito Civil, do Consumidor, Imobiliário e do Trabalho.',
      'Cada caso é analisado individualmente, com orientação clara sobre os caminhos possíveis e atenção às particularidades de cada cliente.',
    ]}
    image={photos.about}
    imagePosition="right"
    cta={{ label: 'Conheça o escritório', href: '/sobre' }}
  />

  <BenefitsSection
    id="como-funciona"
    tone="muted"
    eyebrow="Atendimento"
    title="Como funciona"
    items={howItWorks}
    variant="numbered"
  />

  <CTASection
    variant="card"
    title="Você só procura um advogado quando o problema já aconteceu?"
    description="A consultoria jurídica existe para evitar que isso aconteça. Converse antes de assinar contratos ou tomar decisões importantes."
    primaryCta={{ label: 'Falar com a advogada', href: contactHref }}
    secondaryCta={{ label: 'Consultoria jurídica', href: '/areas#consultoria' }}
  />

  <FAQSection eyebrow="Dúvidas" title="Perguntas frequentes" items={faq} />

  <CTASection
    title="Precisa de orientação jurídica?"
    description="Entre em contato e agende um atendimento presencial ou online."
    primaryCta={{ label: 'Agendar atendimento', href: contactHref }}
    secondaryCta={{ label: 'Outras formas de contato', href: '/contato' }}
  />
</BaseLayout>
