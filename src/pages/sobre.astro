---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import BenefitsSection from '../components/sections/BenefitsSection.astro';
import CTASection from '../components/sections/CTASection.astro';
import { photos, serviceFormats } from '../data/castro';
import { lawyer, site } from '../config/site';
import { primaryContactHref } from '../lib/contact';

const contactHref = primaryContactHref();
---

<BaseLayout
  title="Sobre"
  description="Conheça a Castro Advocacia e a advogada Carolina Araújo. Atendimento presencial em BH e Conselheiro Lafaiete e online em todo o Brasil."
>
  <Hero
    variant="page"
    eyebrow="Sobre"
    title="Advocacia especializada, com atendimento próximo"
    description="Soluções personalizadas e estratégicas em Direito Civil, do Consumidor, Imobiliário e do Trabalho."
  />

  <Section labelledby="advogada-title">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <figure class="relative lg:col-span-5">
        <svg class="pointer-events-none absolute -top-10 -left-10 hidden w-[115%] text-primary sm:block" viewBox="0 0 400 400" fill="none" aria-hidden="true">
          <circle cx="200" cy="200" r="160" stroke="currentColor" stroke-opacity=".2"></circle>
        </svg>
        <Image
          src={photos.profile.src}
          alt={photos.profile.alt}
          widths={[480, 760, 1080]}
          sizes="(min-width: 1024px) 40vw, 100vw"
          class="relative aspect-[4/5] w-full rounded-t-full rounded-b-card object-cover"
        />
      </figure>

      <div class="lg:col-span-6 lg:col-start-7">
        <p class="mb-4 text-sm font-medium tracking-[0.08em] text-accent uppercase">{lawyer.role}</p>
        <h2 id="advogada-title" class="text-h2">{lawyer.name}</h2>
        {lawyer.oab && <p class="mt-2 text-muted">{lawyer.oab}</p>}

        <div class="prose-content text-lead mt-6 text-muted">
          <p>
            À frente da Castro Advocacia, Carolina Araújo atua em Direito Civil, do Consumidor, Imobiliário e do
            Trabalho, além de consultoria jurídica e serviços extrajudiciais.
          </p>
          <p>
            O atendimento é presencial em Belo Horizonte e Conselheiro Lafaiete e online para clientes de todo o
            Brasil.
          </p>
          <p>
            No Instagram, o escritório compartilha conteúdos informativos sobre direitos do consumidor, contratos de
            imóveis, relações de trabalho e outras questões do dia a dia.
          </p>
        </div>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <Button href={contactHref} size="lg">Agendar atendimento</Button>
          {
            site.social.instagram && (
              <Button href={site.social.instagram} size="lg" variant="secondary">
                Instagram @castro.adv_
              </Button>
            )
          }
          {
            site.social.linkedin && (
              <Button href={site.social.linkedin} size="lg" variant="secondary">
                LinkedIn
              </Button>
            )
          }
        </div>
      </div>
    </div>
  </Section>

  <BenefitsSection tone="muted" id="formatos" eyebrow="Atendimento" title="Onde e como atendemos" items={serviceFormats} />

  <CTASection
    title="Vamos conversar sobre o seu caso?"
    description="Agende um atendimento presencial ou online."
    primaryCta={{ label: 'Agendar atendimento', href: contactHref }}
    secondaryCta={{ label: 'Áreas de atuação', href: '/areas' }}
  />
</BaseLayout>
