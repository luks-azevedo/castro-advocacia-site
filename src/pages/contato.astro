---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import { faq } from '../data/castro';
---

<BaseLayout
  title="Contato"
  description="Agende um atendimento com a Castro Advocacia: presencial em Belo Horizonte e Conselheiro Lafaiete ou online em todo o Brasil."
>
  <Hero
    variant="page"
    eyebrow="Contato"
    title="Agende um atendimento"
    description="Conte brevemente a sua situação. O retorno é feito pelo canal que você preferir."
  />

  <ContactSection
    title="Fale com o escritório"
    description="Atendimento presencial em Belo Horizonte e Conselheiro Lafaiete e online em todo o Brasil."
  />

  <FAQSection tone="muted" eyebrow="Dúvidas" title="Antes de entrar em contato" items={faq} />
</BaseLayout>
